# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/pet-adoption

# JWT Configuration
JWT_SECRET=pet-adoption-super-secret-key-2024

# Cloudinary Configuration (for image uploads)
